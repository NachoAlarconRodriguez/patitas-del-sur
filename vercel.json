{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/(admin|admin/.*|mi-cuenta|mi-cuenta/.*|login|tarjeta|tarjeta/.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/(mercadopago-order|mercadopago-webhook|admin-push-notify|indexnow)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/llms.txt", "destination": "/api/llms?mode=summary" },
    { "source": "/llms-full.txt", "destination": "/api/llms?mode=full" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!api/|images/|assets/|favicon|robots\\.txt|sitemap\\.xml|llms|manifest|sw\\.js|7c4e9b2a8f1d4e6a9c3b5d7f2a8e4c1b\\.txt).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^(WhatsApp/.*|.*(facebookexternalhit|Facebot|meta-externalagent|Meta-ExternalAgent|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|OAI-SearchBot|ChatGPT-User|GPTBot|PerplexityBot|ClaudeBot|Claude-SearchBot|Claude-User|anthropic-ai|Google-Extended|Applebot|Amazonbot|bingbot|BingPreview|DuckDuckBot|YandexBot).*)$"
        }
      ],
      "destination": "/api/og?path=/$1"
    },
    { "source": "/((?!api/|assets/).*)", "destination": "/_spa" }
  ]
}
